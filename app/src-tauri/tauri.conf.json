{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Sessions",
  "version": "0.1.0",
  "identifier": "tech.aryakesarwani.claude-sessions",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude Sessions",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../cs.py": "cs.py"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}